SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Exact serving origin, no trailing slash. Use your Netlify URL in production.
APP_ORIGIN=http://localhost:3000

# Optional: Cloudflare Turnstile CAPTCHA on sign-in, sign-up and email requests. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to true on the launch domain (at build time) to allow search engines and publish robots/sitemap rules.
SITE_INDEXING=false

# Supabase Edge Function secrets (set with `supabase secrets set`, not in Netlify):
# RESUME_SCAN_WORKER_SECRET, RESUME_SCANNER_URL, RESUME_SCANNER_TOKEN, RESUME_SCAN_REQUIRED=true
# JOB_ALERT_WORKER_SECRET, JOB_ALERTS_ENABLED=true, RESEND_API_KEY, NOTIFICATION_FROM, APP_ORIGIN
# JOB_FEED_WORKER_SECRET
# STRIPE_SECRET_KEY, STRIPE_PRICE_SPONSOR (a GST-inclusive AUD price), STRIPE_WEBHOOK_SECRET, SPONSOR_DAYS=30
# OPENAI_API_KEY is also read by the Netlify app for the listing assistant and resume autofill.

# Social sign-in buttons to show, after enabling each provider in Supabase Auth: google,apple,linkedin_oidc
NEXT_PUBLIC_AUTH_PROVIDERS=

# Push notifications (job alerts on phones and browsers). Generate once with: npx web-push generate-vapid-keys
# The public key goes here and in the job-alerts function as VAPID_PUBLIC_KEY, with VAPID_PRIVATE_KEY and VAPID_SUBJECT=mailto:you@domain.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
